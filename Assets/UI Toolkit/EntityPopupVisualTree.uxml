<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/EntityPopupStyle.uss?fileID=7433441132597879392&amp;guid=3fada4e4e9baed525b8fa0e1ddb6874e&amp;type=3#EntityPopupStyle" />
    <ui:VisualElement name="Close" style="flex-grow: 1; align-self: flex-end; justify-content: flex-start; align-items: auto; max-width: 7%; max-height: 16%; width: 10%; height: 10%; position: absolute; background-image: none;">
        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="closeBtn" style="background-image: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=8228938214290033325&amp;guid=8d8681264066a3104b6fbf0f2f9ebdd1&amp;type=3#console.erroricon&quot;); background-color: rgba(188, 188, 188, 0.52);">
            <ui:Label tabindex="-1" text="Close" parse-escape-sequences="true" display-tooltip-when-elided="true" name="closeLbl" style="align-self: center; align-items: auto; bottom: auto; top: 50%; -unity-font-style: bold;" />
        </ui:Button>
    </ui:VisualElement>
    <ui:VisualElement name="Root" style="flex-grow: 1; align-self: flex-end; top: auto; right: auto; background-color: rgb(255, 255, 255); width: 100%; height: 100%; align-items: center; opacity: 1; visibility: hidden; flex-direction: row; flex-basis: auto; flex-wrap: nowrap; overflow: visible; position: absolute;">
        <ui:VisualElement name="MainInfo" style="flex-grow: 1; width: auto; height: 100%; visibility: visible; align-self: auto; -unity-background-image-tint-color: rgba(255, 255, 255, 0); background-color: rgb(0, 93, 255); max-width: 30%; max-height: 100%; flex-direction: row; align-items: flex-start;">
            <ui:Label tabindex="-1" text="Null" parse-escape-sequences="true" display-tooltip-when-elided="true" name="nameLbl" class="nameLbl" style="visibility: visible; flex-wrap: wrap; white-space: normal; font-size: 30px;" />
        </ui:VisualElement>
        <ui:VisualElement name="CraftingDisplay" style="flex-grow: 1; height: 100%; width: 63%; align-self: auto; background-color: rgb(255, 0, 14); visibility: visible; justify-content: flex-start; top: auto; flex-basis: auto; flex-direction: column; align-items: flex-start; max-width: 63%; max-height: 100%;">
            <ui:Label tabindex="-1" text="Crafting Options" parse-escape-sequences="true" display-tooltip-when-elided="true" name="craftLBL" style="font-size: 30px;" />
            <ui:VisualElement name="CraftItemSelected" style="flex-grow: 1; left: 34%; top: 10%; max-height: 4000%; width: 63%; height: 90%; position: absolute; background-color: rgba(0, 0, 0, 0.14);">
                <ui:VisualElement name="itemImg" style="flex-grow: 1; width: 20%; height: 20%; max-width: 20%; max-height: 20%; left: auto; top: 5%; background-color: rgb(0, 0, 0); align-self: center;" />
                <ui:VisualElement name="itemDetails" style="flex-grow: 1; width: 80%; height: 60%; max-width: 80%; max-height: 60%; top: 8%; left: auto; background-color: rgb(0, 0, 0); align-self: center;" />
                <ui:Button text="Select" parse-escape-sequences="true" display-tooltip-when-elided="true" name="selectItemBtn" style="top: 10%; max-width: 30%; max-height: 8%; width: 30%; height: 8%; align-self: center;" />
            </ui:VisualElement>
            <ui:ListView name="CraftOptions" style="background-color: rgba(0, 0, 0, 0.17); display: flex; align-items: auto; max-height: 4000%; width: 30%; height: 90%; flex-direction: row; flex-wrap: wrap; margin-top: 1px; margin-right: 1px; margin-bottom: 1px; margin-left: 1px; padding-top: 1px; padding-right: 1px; padding-bottom: 1px; padding-left: 1px; flex-grow: 1; top: 10%; position: absolute; left: 2%;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
